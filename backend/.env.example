# Conexión a la base de datos
# PostgreSQL: postgresql://usuario:contraseña@localhost:5432/foodstore_db
# (si la contraseña tiene caracteres especiales se codifican, por ejemplo @ como %40)
# Desarrollo con SQLite: sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:123456%40@localhost:5432/foodstore_db

# Firma del JWT (mínimo 32 caracteres)
SECRET_KEY=k9P#mX2vL8qR$4nT7wZ@3jB6yF5hC9dG2
ALGORITHM=HS256

# Expiración del token y de la cookie, en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173
